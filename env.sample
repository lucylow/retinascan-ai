BIOSTRAP_API_KEY=
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/retinascan
DATA_DIR=./data

# Frontend
VITE_API_BASE_URL=http://localhost:5000
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend
SECRET_KEY=dev-secret-key-2023
# Include all allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# MODEL_PATH=models/retina_model.h5

# EHR Integration - FHIR Configuration
# FHIR_BASE_URL=https://fhir.epic.com/api/FHIR/R4
FHIR_CLIENT_ID=your_fhir_client_id_here
FHIR_CLIENT_SECRET=your_fhir_client_secret_here
FHIR_AUTH_URL=https://fhir.epic.com/Interconnect-FHIR-Proxy-UserOAuth/oauth2/authorize
FHIR_TOKEN_URL=https://fhir.epic.com/Interconnect-FHIR-Proxy-UserOAuth/oauth2/token
FHIR_REDIRECT_URI=http://localhost:5000/api/auth/callback

# HL7 v2 Configuration (for legacy systems)
HL7_HOST=localhost
HL7_PORT=2575
HL7_USE_TLS=false

# Workflow Configuration
AUTO_APPROVE_CONFIDENCE=0.9
AUTO_APPROVE_MAX_SEVERITY=1
REQUIRE_HUMAN_REVIEW=true
ENABLE_REFERRAL_AUTOMATION=true
ENABLE_FOLLOW_UP_SCHEDULING=true
